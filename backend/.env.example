# ════════════════════════════════════════════════════════════════════════════════
# TRUSTDESK BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env` for local development.
# ════════════════════════════════════════════════════════════════════════════════

# ── Database (PostgreSQL 16 with pgvector) ───────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trustdesk:trustdesk_secret@localhost:5432/trustdesk

# ── Redis 7 (Caching, Queue & OTP State Store) ──────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Authentication & Cryptographic Keys ──────────────────────────────────────
JWT_SECRET=replace-with-a-secure-random-32-byte-hex-string-for-jwt-signing
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── CSRF Protection ──────────────────────────────────────────────────────────
CSRF_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-csrf
CSRF_COOKIE_NAME=trustdesk_csrf_token

# ── HTTPS & Transport Security ───────────────────────────────────────────────
ENFORCE_HTTPS=False

# ── Secrets Management (Optional Encrypted Store) ────────────────────────────
# TRUSTDESK_MASTER_KEY=your-secure-master-encryption-key
# TRUSTDESK_SECRETS_FILE=secrets.enc

# ── OAuth 2.0 / Corporate SSO (Optional) ─────────────────────────────────────
OAUTH_ENABLED=False
OAUTH_PROVIDER=corporate_oidc
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# ── AI Model Routing & OpenRouter API ────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_FAST=google/gemini-2.0-flash-001
MODEL_CAPABLE=google/gemini-2.5-flash-preview-05-20
MODEL_REASONING=google/gemini-2.5-pro-preview-05-06
EMBEDDING_MODEL=google/gemini-embedding-exp

# ── SMTP Email Gateway for MFA & OTP Delivery ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@example.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=support@example.com
SMTP_TLS=True

# ── Observability, Tracing & Logging ─────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
LOG_FORMAT=json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
